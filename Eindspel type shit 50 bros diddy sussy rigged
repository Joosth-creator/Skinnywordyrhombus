"""
Flappy Bird met NEAT:
1. Train 50 generaties.
2. Sla het beste genome op als winner.pkl.
3. Laat daarna alleen de beste vogel spelen.
"""

import os
import pickle
import random

import neat
import pygame


# --------------------------------------------------
# INSTELLINGEN
# --------------------------------------------------

pygame.init()
pygame.font.init()

WIN_WIDTH = 600
WIN_HEIGHT = 800
FLOOR = 730

STAT_FONT = pygame.font.SysFont("comicsans", 50)
END_FONT = pygame.font.SysFont("comicsans", 70)

DRAW_LINES = False

WIN = pygame.display.set_mode((WIN_WIDTH, WIN_HEIGHT))
pygame.display.set_caption("Flappy Bird - NEAT")

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
IMG_DIR = os.path.join(BASE_DIR, "imgs")

CONFIG_PATH = os.path.join(BASE_DIR, "config-feedforward.txt")
WINNER_PATH = os.path.join(BASE_DIR, "winner.pkl")


# --------------------------------------------------
# AFBEELDINGEN LADEN
# --------------------------------------------------

def load_image(filename):
    path = os.path.join(IMG_DIR, filename)

    if not os.path.isfile(path):
        raise FileNotFoundError(
            f"Afbeelding niet gevonden: {path}\n"
            "Controleer of de map 'imgs' naast main.py staat."
        )

    return pygame.image.load(path).convert_alpha()


pipe_img = pygame.transform.scale2x(load_image("pipe.png"))

bg_img = pygame.transform.scale(
    load_image("bg.png"),
    (WIN_WIDTH, 900)
)

bird_images = [
    pygame.transform.scale2x(load_image(f"bird{x}.png"))
    for x in range(1, 4)
]

base_img = pygame.transform.scale2x(load_image("base.png"))

gen = 0


# --------------------------------------------------
# VOGEL
# --------------------------------------------------

class Bird:
    MAX_ROTATION = 25
    IMGS = bird_images
    ROT_VEL = 20
    ANIMATION_TIME = 5

    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.tilt = 0
        self.tick_count = 0
        self.vel = 0
        self.height = self.y
        self.img_count = 0
        self.img = self.IMGS[0]

    def jump(self):
        self.vel = -10.5
        self.tick_count = 0
        self.height = self.y

    def move(self):
        self.tick_count += 1

        displacement = (
            self.vel * self.tick_count
            + 0.5 * 3 * self.tick_count ** 2
        )

        if displacement >= 16:
            displacement = 16

        if displacement < 0:
            displacement -= 2

        self.y += displacement

        if displacement < 0 or self.y < self.height + 50:
            if self.tilt < self.MAX_ROTATION:
                self.tilt = self.MAX_ROTATION
        else:
            if self.tilt > -90:
                self.tilt -= self.ROT_VEL

    def draw(self, win):
        self.img_count += 1

        if self.img_count <= self.ANIMATION_TIME:
            self.img = self.IMGS[0]
        elif self.img_count <= self.ANIMATION_TIME * 2:
            self.img = self.IMGS[1]
        elif self.img_count <= self.ANIMATION_TIME * 3:
            self.img = self.IMGS[2]
        elif self.img_count <= self.ANIMATION_TIME * 4:
            self.img = self.IMGS[1]
        else:
            self.img = self.IMGS[0]
            self.img_count = 0

        if self.tilt <= -80:
            self.img = self.IMGS[1]
            self.img_count = self.ANIMATION_TIME * 2

        blit_rotate_center(win, self.img, (self.x, self.y), self.tilt)

    def get_mask(self):
        return pygame.mask.from_surface(self.img)


# --------------------------------------------------
# PIJP
# --------------------------------------------------

class Pipe:
    GAP = 160
    VEL = 10

    def __init__(self, x):
        self.x = x
        self.height = 0
        self.top = 0
        self.bottom = 0

        self.PIPE_TOP = pygame.transform.flip(pipe_img, False, True)
        self.PIPE_BOTTOM = pipe_img

        self.passed = False
        self.set_height()

    def set_height(self):
        self.height = random.randrange(50, 450)
        self.top = self.height - self.PIPE_TOP.get_height()
        self.bottom = self.height + self.GAP

    def move(self):
        self.x -= self.VEL

    def draw(self, win):
        win.blit(self.PIPE_TOP, (self.x, self.top))
        win.blit(self.PIPE_BOTTOM, (self.x, self.bottom))

    def collide(self, bird):
        bird_mask = bird.get_mask()
        top_mask = pygame.mask.from_surface(self.PIPE_TOP)
        bottom_mask = pygame.mask.from_surface(self.PIPE_BOTTOM)

        top_offset = (self.x - bird.x, self.top - round(bird.y))
        bottom_offset = (self.x - bird.x, self.bottom - round(bird.y))

        top_point = bird_mask.overlap(top_mask, top_offset)
        bottom_point = bird_mask.overlap(bottom_mask, bottom_offset)

        return bool(top_point or bottom_point)


# --------------------------------------------------
# GROND
# --------------------------------------------------

class Base:
    VEL = 5
    WIDTH = base_img.get_width()
    IMG = base_img

    def __init__(self, y):
        self.y = y
        self.x1 = 0
        self.x2 = self.WIDTH

    def move(self):
        self.x1 -= self.VEL
        self.x2 -= self.VEL

        if self.x1 + self.WIDTH < 0:
            self.x1 = self.x2 + self.WIDTH

        if self.x2 + self.WIDTH < 0:
            self.x2 = self.x1 + self.WIDTH

    def draw(self, win):
        win.blit(self.IMG, (self.x1, self.y))
        win.blit(self.IMG, (self.x2, self.y))


# --------------------------------------------------
# TEKENFUNCTIES
# --------------------------------------------------

def blit_rotate_center(surf, image, topleft, angle):
    rotated_image = pygame.transform.rotate(image, angle)
    new_rect = rotated_image.get_rect(
        center=image.get_rect(topleft=topleft).center
    )
    surf.blit(rotated_image, new_rect.topleft)


def draw_window(win, birds, pipes, base, score, generation, pipe_ind=0):
    win.blit(bg_img, (0, 0))

    for pipe in pipes:
        pipe.draw(win)

    base.draw(win)

    for bird in birds:
        if DRAW_LINES and pipes:
            try:
                pipe = pipes[pipe_ind]

                bird_center = (
                    bird.x + bird.img.get_width() / 2,
                    bird.y + bird.img.get_height() / 2
                )

                top_center = (
                    pipe.x + pipe.PIPE_TOP.get_width() / 2,
                    pipe.height
                )

                bottom_center = (
                    pipe.x + pipe.PIPE_BOTTOM.get_width() / 2,
                    pipe.bottom
                )

                pygame.draw.line(
                    win, (255, 0, 0), bird_center, top_center, 5
                )

                pygame.draw.line(
                    win, (255, 0, 0), bird_center, bottom_center, 5
                )

            except IndexError:
                pass

        bird.draw(win)

    score_label = STAT_FONT.render(
        f"Score: {score}", True, (255, 255, 255)
    )

    win.blit(
        score_label,
        (WIN_WIDTH - score_label.get_width() - 15, 10)
    )

    generation_label = STAT_FONT.render(
        f"Gens: {generation}", True, (255, 255, 255)
    )

    win.blit(generation_label, (10, 10))

    alive_label = STAT_FONT.render(
        f"Alive: {len(birds)}", True, (255, 255, 255)
    )

    win.blit(alive_label, (10, 50))

    pygame.display.update()


# --------------------------------------------------
# NEAT TRAINING
# --------------------------------------------------

def eval_genomes(genomes, config):
    global gen

    gen += 1
    alive = []

    for genome_id, genome in genomes:
        genome.fitness = 0

        net = neat.nn.FeedForwardNetwork.create(genome, config)
        bird = Bird(230, 350)

        alive.append({
            "genome": genome,
            "net": net,
            "bird": bird
        })

    base = Base(FLOOR)
    pipes = [Pipe(700)]
    score = 0

    clock = pygame.time.Clock()

    while alive:
        clock.tick(400)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                raise SystemExit

        pipe_ind = 0

        if len(pipes) > 1:
            if alive[0]["bird"].x > (
                pipes[0].x + pipes[0].PIPE_TOP.get_width()
            ):
                pipe_ind = 1

        current_pipe = pipes[pipe_ind]

        for item in alive:
            bird = item["bird"]
            genome = item["genome"]
            net = item["net"]

            genome.fitness += 0.1

            bird.move()

            output = net.activate((
                bird.y,
                abs(bird.y - current_pipe.height),
                abs(bird.y - current_pipe.bottom)
            ))

            if output[0] > 0.5:
                bird.jump()

        base.move()

        for pipe in pipes:
            pipe.move()

        dead = []

        for item in alive:
            bird = item["bird"]
            genome = item["genome"]

            for pipe in pipes:
                if pipe.collide(bird):
                    genome.fitness -= 1
                    dead.append(item)
                    break

            if (
                bird.y + bird.img.get_height() - 10 >= FLOOR
                or bird.y < -50
            ):
                if item not in dead:
                    dead.append(item)

        for item in dead:
            if item in alive:
                alive.remove(item)

        add_pipe = False

        if alive:
            bird_x = alive[0]["bird"].x

            for pipe in pipes:
                if (
                    not pipe.passed
                    and pipe.x + pipe.PIPE_TOP.get_width() < bird_x
                ):
                    pipe.passed = True
                    add_pipe = True

        if add_pipe:
            score += 1

            for item in alive:
                item["genome"].fitness += 5

            pipes.append(Pipe(WIN_WIDTH))

        pipes = [
            pipe for pipe in pipes
            if pipe.x + pipe.PIPE_TOP.get_width() > 0
        ]

        birds = [item["bird"] for item in alive]

        draw_window(
            WIN,
            birds,
            pipes,
            base,
            score,
            gen,
            min(pipe_ind, len(pipes) - 1)
        )


# --------------------------------------------------
# TRAINING STARTEN EN WINNAAR OPSLAAN
# --------------------------------------------------

def run(config_file):
    if not os.path.isfile(config_file):
        raise FileNotFoundError(
            f"NEAT-configuratie niet gevonden: {config_file}"
        )

    config = neat.config.Config(
        neat.DefaultGenome,
        neat.DefaultReproduction,
        neat.DefaultSpeciesSet,
        neat.DefaultStagnation,
        config_file
    )

    population = neat.Population(config)

    population.add_reporter(neat.StdOutReporter(True))
    population.add_reporter(neat.StatisticsReporter())

    print("Training gestart: 50 generaties...")

    winner = population.run(eval_genomes, 50)

    print("\nBeste genome:")
    print(winner)

    with open(WINNER_PATH, "wb") as file:
        pickle.dump(winner, file)

    print("\nBeste vogel opgeslagen:")
    print(WINNER_PATH)


# --------------------------------------------------
# EINDspel: ALLEEN DE BESTE VOGEL
# --------------------------------------------------

def play_winner(config_file):
    if not os.path.isfile(WINNER_PATH):
        raise FileNotFoundError(
            f"winner.pkl niet gevonden: {WINNER_PATH}"
        )

    config = neat.config.Config(
        neat.DefaultGenome,
        neat.DefaultReproduction,
        neat.DefaultSpeciesSet,
        neat.DefaultStagnation,
        config_file
    )

    with open(WINNER_PATH, "rb") as file:
        winner = pickle.load(file)

    net = neat.nn.FeedForwardNetwork.create(winner, config)

    print("Het eindspel begint!")
    print("De beste vogel gaat spelen!")

    bird = Bird(230, 350)
    base = Base(FLOOR)
    pipes = [Pipe(700)]

    score = 0
    clock = pygame.time.Clock()
    game_over = False

    while True:
        clock.tick(150)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return

            if game_over and event.type == pygame.KEYDOWN:
                return

        if not game_over:
            pipe_ind = 0

            if len(pipes) > 1:
                if bird.x > (
                    pipes[0].x + pipes[0].PIPE_TOP.get_width()
                ):
                    pipe_ind = 1

            current_pipe = pipes[pipe_ind]

            bird.move()

            output = net.activate((
                bird.y,
                abs(bird.y - current_pipe.height),
                abs(bird.y - current_pipe.bottom)
            ))

            if output[0] > 0.5:
                bird.jump()

            base.move()

            for pipe in pipes:
                pipe.move()

            add_pipe = False

            for pipe in pipes:
                if (
                    not pipe.passed
                    and pipe.x + pipe.PIPE_TOP.get_width() < bird.x
                ):
                    pipe.passed = True
                    add_pipe = True

            if add_pipe:
                score += 1
                pipes.append(Pipe(WIN_WIDTH))

            pipes = [
                pipe for pipe in pipes
                if pipe.x + pipe.PIPE_TOP.get_width() > 0
            ]

            for pipe in pipes:
                if pipe.collide(bird):
                    game_over = True
                    break

            if (
                bird.y + bird.img.get_height() - 10 >= FLOOR
                or bird.y < -50
            ):
                game_over = True

        draw_window(
            WIN,
            [bird] if not game_over else [],
            pipes,
            base,
            score,
            0,
            0
        )

        if game_over:
            game_over_text = END_FONT.render(
                "GAME OVER", True, (255, 0, 0)
            )

            score_text = STAT_FONT.render(
                f"Score: {score}", True, (255, 255, 255)
            )

            restart_text = STAT_FONT.render(
                "Druk op een toets om af te sluiten",
                True,
                (255, 255, 255)
            )

            WIN.blit(
                game_over_text,
                (
                    WIN_WIDTH // 2 - game_over_text.get_width() // 2,
                    250
                )
            )

            WIN.blit(
                score_text,
                (
                    WIN_WIDTH // 2 - score_text.get_width() // 2,
                    340
                )
            )

            WIN.blit(
                restart_text,
                (
                    WIN_WIDTH // 2 - restart_text.get_width() // 2,
                    430
                )
            )

            pygame.display.update()


# --------------------------------------------------
# HOOFDPROGRAMMA
# --------------------------------------------------

if __name__ == "__main__":
    try:
        run(CONFIG_PATH)
        play_winner(CONFIG_PATH)
    finally:
        pygame.quit()
